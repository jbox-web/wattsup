<?xml version="1.0" encoding="utf-8"?>
<!-- The installer of Watt's Up, made by apple/package.sh (@...@ substituted there). -->
<installer-gui-script minSpecVersion="2">
    <title>Watt's Up</title>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <allowed-os-versions>
        <os-version min="14.0"/>
    </allowed-os-versions>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="Watt's Up">
        <pkg-ref id="@BUNDLE_ID@.pkg"/>
    </choice>
    <pkg-ref id="@BUNDLE_ID@.pkg" version="@VERSION@">component.pkg</pkg-ref>
</installer-gui-script>
