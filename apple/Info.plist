<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>fr.nicoladmin.wattsup</string>
    <key>CFBundleName</key>
    <string>Watt's Up</string>
    <key>CFBundleDisplayName</key>
    <string>Watt's Up</string>
    <key>CFBundleExecutable</key>
    <string>Watt's Up</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@BUILD@</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <!-- Also lists the app under System Settings › Language & Region › Applications. -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>fr</string>
    </array>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <!-- Menu bar only: no Dock icon, no main menu. -->
    <key>LSUIElement</key>
    <true/>
    <!-- Sparkle: the appcast.xml of the latest GitHub Release, checked once a day. Updates
         are signed with the private key of account "wattsup" in the login Keychain (Sparkle's
         generate_keys and sign_update); an update is installed only once the user accepts. -->
    <key>SUFeedURL</key>
    <string>@FEED_URL@</string>
    <key>SUPublicEDKey</key>
    <string>6NfZ67AC5uEfDp3/GJX5E/FvZT2OHQxFAHQxJxDkBcU=</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
    <key>SUAllowsAutomaticUpdates</key>
    <false/>
</dict>
</plist>
